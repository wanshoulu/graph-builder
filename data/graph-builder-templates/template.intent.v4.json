        "faqs": [
          {
            "id": "faq.fund.subscription.rule",
            "question": "基金定投的扣款规则是什么？",
            "answer": "基金定投按您设置的扣款日和每期金额自动扣款，扣款日遇节假日顺延至下一交易日；连续三次扣款失败将自动暂停该计划。",
            "updatedAt": "2026-09-17"
          },
          {
            "id": "faq.fund.subscription.fee",
            "question": "基金定投手续费多少？",
            "answer": "定投申购费率与单笔申购一致，多数基金一折起；具体费率以各基金产品公告为准。",
            "updatedAt": "2026-09-17"
          },
          {
            "id": "faq.fund.subscription.pause",
            "question": "定投可以暂停吗？",
            "answer": "可以。您可在定投详情页申请暂停或终止计划，暂停期间不再扣款，恢复后按原设置继续。",
            "updatedAt": "2026-09-17"
          }
        ],
        "policies": [
