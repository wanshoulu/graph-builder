# dependencies
node_modules/

# env & secrets
.env
.env.local
*.key

# runtime data — 保留种子清单与草稿，忽略运行期生成物
data/knowledge-intake/*
!data/knowledge-intake/.gitkeep
data/graphs/org/**/drafts/history/
data/graphs/org/**/drafts/extract-cache/
data/graphs/org/**/publish-requests/
data/graphs/org/**/org-graph-v[0-9]*.json
!data/graphs/org/intent/drafts/org-graph-draft.json

# logs
*.log
npm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# runtime artifacts of the standalone前端/自动建图（保留种子 demo.json、menu-tree.json 与 org-graph-draft.json）
data/graphs/autobuild-jobs/
data/graphs/org/**/publish-requests/
data/graphs/org/**/drafts/extract-cache/

# RSI 意图进化运行期产物（种子 rsi-graph.v1.json / rsi-eval-cases*.json 保留入库）
data/rsi/artifacts/*
data/rsi/checkpoints/*
data/rsi/drafts/*
data/rsi/logs/*
data/rsi/tasks/*
data/rsi/snapshots/*
data/rsi/versions/*
data/rsi/calibration/*
data/rsi/heldout-archive/*
data/rsi/validation-*/
data/rsi/*.backup.*
!data/rsi/**/.gitkeep
data/rsi/rsi-state.json
data/rsi/active-task.json
.tmp-tests/

# Python
__pycache__/
*.pyc
.pytest_cache/
