# graph-builder 模型密钥配置 — 复制为 .env 并填入至少一个 key
# 未配置任何 key 时服务可启动，但 AI 辅助功能（AI 映射/抽取/试算）不可用，
# 模板校验、草稿管理、应用/回滚等离线能力不受影响。
# RSI 意图进化：基线/评分走确定性引擎可完全离线；Agent 决策模式需要下列 key 之一。

DEEPSEEK_KEY=
QWEN_KEY=
KIMI_KEY=
GLM_KEY=
VOLCANO_KEY=

# ── 服务行为（可选） ──
# PORT=3013
# HOST=127.0.0.1            # 默认仅本机可访问；对外提供服务时务必先配好认证
# SKIP_AUTH=true            # 生产环境务必设为 false 并配置 JWT_SECRET
# DEV_MODE=true
# REQUIRE_PUBLISH_APPROVAL=false
# KNOWLEDGE_INTAKE_DIR=./data/knowledge-intake

# ── RSI 意图进化（可选） ──
# INTENT_RSI_DIR=./data/rsi              # 状态/版本/快照/任务根目录
# INTENT_LLM_ROUTE=qwen3.7-flash         # 评测引擎默认对话路由，见 config/api-keys.js
# INTENT_EMBEDDING_ROUTE=text-embedding-v4
# RSI_SCORING_MAX_CONCURRENCY=8
# RSI_AGENT_URL=http://127.0.0.1:18132  # Node → Python Agent；容器部署改成服务名

# ── 仅启动 services/rsi-agent 时需要 ──
# RSI_AGENT_API_BASE_URL=http://127.0.0.1:3013/api/intent-rsi/agent  # Agent → Node 工具桥
# RSI_AGENT_MODEL_NAME=qwen-plus
# RSI_AGENT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RSI_AGENT_MODEL_API_KEY=
# RSI_AGENT_PORT=18132
# RSI_AGENT_MAX_ITERATIONS=56
