# graph-builder 模型密钥配置 — 复制为 .env 并填入至少一个 key
# 未配置任何 key 时服务可启动，但 AI 辅助功能（AI 映射/抽取/试算）不可用，
# 模板校验、草稿管理、应用/回滚等离线能力不受影响。

DEEPSEEK_KEY=
QWEN_KEY=
KIMI_KEY=
GLM_KEY=
VOLCANO_KEY=

# ── 服务行为（可选） ──
# PORT=3013
# HOST=127.0.0.1            # 默认仅本机可访问；对外提供服务时务必先配好认证
# SKIP_AUTH=true            # 生产环境务必设为 false 并配置 JWT_SECRET
# DEV_MODE=true
# REQUIRE_PUBLISH_APPROVAL=false
# KNOWLEDGE_INTAKE_DIR=./data/knowledge-intake
