  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "formidable": "^3.5.4",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  }
}
